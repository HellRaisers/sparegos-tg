# ── Telegram (обязательно) ─────────────────────────────────
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# ID чата/группы/канала, куда слать сообщения (можно узнать через @userinfobot)
TELEGRAM_CHAT_ID=-1001234567890

# ── Необязательно ──────────────────────────────────────────
# Всё ниже имеет разумные значения по умолчанию в коде (config.py).
# Раскомментируй и поменяй только если нужно переопределить.
#
# Фильтр писем (синтаксис поиска Gmail). По умолчанию ловит сообщения
# клиентов (оба типа) и приглашения «Invitation to Apply».
# ВАЖНО: если задать здесь — правки фильтра через git push НЕ долетят на
# сервер, пока не обновишь .env. Лучше оставить закомментированным.
# GMAIL_SUBJECT_QUERY=subject:("sent you a message" OR "direct message from a client" OR "Invitation to Apply")
#
# GMAIL_SENDER=upwork.com
# GMAIL_LOOKBACK=2d
# POLL_INTERVAL_SECONDS=600
