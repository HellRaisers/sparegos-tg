# ── Telegram ───────────────────────────────────────────────
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# ID чата/группы/канала, куда слать сообщения (можно узнать через @userinfobot)
TELEGRAM_CHAT_ID=-1001234567890

# ── Фильтр писем (синтаксис поиска Gmail) ──────────────────
# От кого. upwork.com покроет все адреса Upwork (notifications@, messages@ и т.д.)
GMAIL_SENDER=upwork.com
# Условие по теме. Перечисли варианты темы письма "новое сообщение".
GMAIL_SUBJECT_QUERY=subject:("new message" OR "sent you a message" OR "новое сообщение")
# За какой период смотреть письма при каждой проверке (запас на случай простоя).
GMAIL_LOOKBACK=2d

# ── Прочее ─────────────────────────────────────────────────
# Интервал опроса в секундах для режима --loop (600 = 10 минут)
POLL_INTERVAL_SECONDS=600

# Пути к файлам (можно не трогать)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
STATE_FILE=state.json
